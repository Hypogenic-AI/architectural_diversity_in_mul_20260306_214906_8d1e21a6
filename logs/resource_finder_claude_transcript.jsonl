 url = f\"https://arxiv.org/pdf/{arxiv_id}\"\n        print(f\"  Downloading {arxiv_id} -> {name}.pdf ...\")\n        \n        r = requests.get(url, timeout=30, allow_redirects=True, \n                        headers={\"User-Agent\": \"Mozilla/5.0 research\"})\n        \n        if r.status_code == 200 and len(r.content) > 10000:\n            with open(filename, 'wb') as f:\n                f.write(r.content)\n            size_kb = len(r.content) // 1024\n            print(f\"    OK: {size_kb} KB\")\n            downloaded.append((arxiv_id, name, filename))\n        else:\n            print(f\"    FAILED: status={r.status_code}, size={len(r.content)}\")\n            failed.append((arxiv_id, name))\n        \n        time.sleep(1)  # rate limit\n    except Exception as e:\n        print(f\"    ERROR: {e}\")\n        failed.append((arxiv_id, name))\n\nprint(f\"\\nDownloaded: {len(downloaded)}, Failed: {len(failed)}\")\nif failed:\n    print(\"Failed:\", [x[0] for x in failed])\nEOF\n","description":"Download all relevant papers to papers/ directory","timeout":300000},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":544,"cache_read_input_tokens":45152,"cache_creation":{"ephemeral_5m_input_tokens":544,"ephemeral_1h_input_tokens":0},"output_tokens":19,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"0dfc82f5-4d11-42d3-841d-877759aeae79","uuid":"2d3571be-22a1-4d22-8a24-1733adea6579"}
